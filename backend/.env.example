# Copy this to .env and fill in your values

# Groq API - get free key at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=gemma2-9b-it
# Fallback if you want to try the bigger model for complex extraction:
# GROQ_MODEL=llama-3.3-70b-versatile

# Database - use SQLite for dev simplicity, switch to postgres/mysql for prod
DATABASE_URL=sqlite:///./complaints.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/aivoa
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/aivoa

# CORS
FRONTEND_ORIGIN=http://localhost:5173
